{
  "realm": "book",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 12,
  "roles": {
    "realm": [
      {
        "name": "agent-order-reader"
      }
    ]
  },
  "clients": [
    {
      "clientId": "agent-tool",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "public-keycloak-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "tool-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tool-proxy",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "roles"
      ],
      "fullScopeAllowed": true
    },
    {
      "clientId": "untrusted-tool",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "public-keycloak-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "tool-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tool-proxy",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "roles"
      ],
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "service-account-agent-tool",
      "enabled": true,
      "serviceAccountClientId": "agent-tool",
      "realmRoles": [
        "agent-order-reader"
      ]
    },
    {
      "username": "service-account-untrusted-tool",
      "enabled": true,
      "serviceAccountClientId": "untrusted-tool"
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
